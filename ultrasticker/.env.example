DB_HOST=localhost
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=stickers
PORT=3000
BASE_URL=http://localhost:3000

# CORSで追加許可するオリジン(カンマ区切り)。本番のWebドメインをここに入れる。
# 例: ALLOWED_ORIGINS=https://fsmj.example.com
ALLOWED_ORIGINS=

# ------------------------------------------------------------
# Firebase Admin SDK(サーバー側でIDトークンを検証するために使う)
#
# 取得方法:
#   Firebaseコンソール > プロジェクトの設定 > サービスアカウント
#   > 「新しい秘密鍵を生成」でJSONをダウンロードし、その中身を転記する。
#
# ⚠️ この3つは秘密情報。.env は絶対にコミットしないこと。
# ⚠️ FIREBASE_PRIVATE_KEY は改行を \n の2文字のままにしてダブルクォートで囲む。
# ------------------------------------------------------------